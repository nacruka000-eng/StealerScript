-- Проверяем доступные функции для сохранения
local function saveToPhone(data, filename)
    local saved = false
    local savePath = ""
    
    -- Способ 1: writefile (работает в большинстве экзекуторов)
    pcall(function()
        writefile(filename, data)
        saved = true
        savePath = "папка экзекутора/" .. filename
        print("✅ Файл сохранён через writefile")
    end)
    
    -- Способ 2: syn writefile
    if not saved then
        pcall(function()
            syn.writefile(filename, data)
            saved = true
            savePath = "synapse/" .. filename
            print("✅ Файл сохранён через syn.writefile")
        end)
    end
    
    -- Способ 3: rconsole + setclipboard
    if not saved then
        pcall(function()
            rconsoleprint("=== REDZ WASTED ===\n")
            rconsoleprint(data)
            rconsoleprint("\n=== КОНЕЦ ===\n")
            
            setclipboard(data)
            saved = true
            savePath = "буфер обмена (вставь в заметки)"
            print("✅ Код в буфере обмена и консоли")
        end)
    end
    
    return saved, savePath
end

