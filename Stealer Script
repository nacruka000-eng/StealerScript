-- Переменные для сбора кода
local fullCode = ""
local httpCount = 0
local loadstringCount = 0

-- Перехватываем HTTP запросы
local old_http = game.HttpGet
game.HttpGet = function(...)
    local args = {...}
    local url = tostring(args[2] or args[1])
    
    print("🌐 HTTP: " .. url)
    
    local result = old_http(...)
    
    if url:find("luarmor") or url:find("redz") or url:find("hub") then
        httpCount = httpCount + 1
        fullCode = fullCode .. "\n\n--[[ ===== HTTP " .. httpCount .. ": " .. url .. " ===== ]]\n\n"
        fullCode = fullCode .. result .. "\n\n"
        
        -- Сохраняем каждый HTTP отдельно
        pcall(function()
            writefile("RedzWasted_HTTP_" .. httpCount .. ".lua", result)
        end)
    end
    
    return result
end

-- Перехватываем loadstring
local old_load = loadstring
loadstring = function(code, name)
    loadstringCount = loadstringCount + 1
    
    print("📦 LOADSTRING #" .. loadstringCount .. " (" .. #code .. " байт)")
    
    fullCode = fullCode .. "\n\n--[[ ===== LOADSTRING " .. loadstringCount .. " ===== ]]\n\n"
    fullCode = fullCode .. code .. "\n\n"
    
    -- Сохраняем каждый loadstring
    pcall(function()
        writefile("RedzWasted_LOAD_" .. loadstringCount .. ".lua", code)
    end)
    
    return old_load(code, name)
end

